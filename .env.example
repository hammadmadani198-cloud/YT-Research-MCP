# Reference only: the application does not auto-load .env files.
# Set process environment variables; never commit real values.
YOUTUBE_API_KEY=
YTNMCP_DB_PATH=data/research.sqlite3
YTNMCP_LOG_LEVEL=INFO
YTNMCP_DB_TIMEOUT_SECONDS=10
YTNMCP_API_TIMEOUT_SECONDS=20
YTNMCP_API_MAX_RETRIES=2
YTNMCP_API_RETRY_DELAY_SECONDS=0.5
YTNMCP_CACHE_TTL_SECONDS=3600
YTNMCP_CACHE_STALE_SECONDS=300
YTNMCP_API_BATCH_SIZE=50
YTNMCP_BATCH_STATS_ENABLED=false

NEXLEV_API_KEY=
YTNMCP_NEXLEV_TIMEOUT_SECONDS=20
YTNMCP_NEXLEV_SIMILARITY_TIMEOUT_SECONDS=300
